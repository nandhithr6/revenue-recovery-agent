# Razorpay TEST mode credentials. Never commit real values; .env is gitignored.
# Dashboard -> Settings -> API Keys -> switch to Test Mode -> Generate Test Key
# The key id must begin with rzp_test_ ; the live path refuses anything else.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional LLM policy. Free tiers only (Groq, OpenRouter, Cerebras).
LLM_API_KEY=
LLM_PROVIDER=groq
